  <diagram id="TmY4k7f1eeT1n5WN08UZ" name="Page-7">
    <mxGraphModel dx="1845" dy="1286" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\nclassDef trigger  fill:#4A90D9,stroke:#2C5F8A,color:#ffffff,stroke-width:2px;\nclassDef job       fill:#F5F5F5,stroke:#333333,color:#000000;\nclassDef artifact  fill:#F5A623,stroke:#8A5A00,color:#000000;\nclassDef gate      fill:#D9534F,stroke:#7A1F1C,color:#ffffff,stroke-width:2px;\nclassDef notify    fill:#9B59B6,stroke:#5E2D6E,color:#ffffff;\nclassDef external  fill:#7F8C8D,stroke:#4D5656,color:#ffffff,stroke-dasharray: 4 3;\n\n%% ---------- TRIGGERS ----------\nT_PR([\&quot;Pull Request → main\&quot;]):::trigger\nT_PUSH_MAIN([\&quot;Push → main\&quot;]):::trigger\nT_PUSH_TAG([\&quot;Push tag v*\&quot;]):::trigger\nT_MANUAL([\&quot;Manual dispatch (release_tag)\&quot;]):::trigger\n\n%% ---------- STAGE 1: CI ----------\nJ_CI[\&quot;job: ci — Lint / Build / Test&lt;br/&gt;tool: GitHub Actions (pnpm, corepack)&lt;br/&gt;env: staging / production\&quot;]:::job\nT_PR --&gt; J_CI\nT_PUSH_MAIN --&gt; J_CI\nT_PUSH_TAG --&gt; J_CI\n\n%% ---------- STAGE 2A: PR image validation ----------\nJ_DCHECK[\&quot;job: docker-check&lt;br/&gt;tool: docker/build-push-action&lt;br/&gt;env: staging\&quot;]:::job\nART_LOCAL[(\&quot;local runner image cache&lt;br/&gt;— discarded after job\&quot;)]:::artifact\nJ_CI --&gt;|\&quot;if: pull_request\&quot;| J_DCHECK\nJ_DCHECK --&gt; ART_LOCAL\nJ_DCHECK --&gt; N_STATUS\n\n%% ---------- STAGE 2B: staging images ----------\nJ_DSTAGE[\&quot;job: docker-staging&lt;br/&gt;tool: docker/build-push-action + login-action&lt;br/&gt;env: staging\&quot;]:::job\nART_HUB_STAGING[(\&quot;Docker Hub: vigilcs/umtas&lt;br/&gt;*-staging-latest / *-staging-sha\&quot;)]:::artifact\nJ_CI --&gt;|\&quot;if: pull_request OR push→main\&quot;| J_DSTAGE\nJ_DSTAGE --&gt; ART_HUB_STAGING\nJ_DSTAGE --&gt; N_STATUS\n\n%% ---------- STAGE 2C: release images ----------\nJ_DRELEASE[\&quot;job: docker-release&lt;br/&gt;tool: docker/build-push-action + login-action&lt;br/&gt;env: production\&quot;]:::job\nART_HUB_RELEASE[(\&quot;Docker Hub: vigilcs/umtas&lt;br/&gt;*-&amp;lt;release_tag&amp;gt; / *-sha\&quot;)]:::artifact\nJ_CI --&gt;|\&quot;if: tag push v*\&quot;| J_DRELEASE\nJ_DRELEASE --&gt; ART_HUB_RELEASE\nJ_DRELEASE --&gt; N_STATUS\n\n%% ---------- STAGE 3: staging delivery ----------\nEXT_WATCHTOWER[\&quot;Watchtower (staging host)&lt;br/&gt;auto-pulls new staging images\&quot;]:::external\nART_HUB_STAGING -.-&gt; EXT_WATCHTOWER\n\n%% ---------- STAGE 4: staging health check ----------\nJ_HCHECK[\&quot;job: health-check&lt;br/&gt;tool: curl retry loop&lt;br/&gt;env: staging\&quot;]:::job\nJ_DSTAGE --&gt; J_HCHECK\nEXT_WATCHTOWER -.-&gt; J_HCHECK\nJ_HCHECK --&gt; N_STATUS\n\nN_STATUS[\&quot;job: notify-status&lt;br/&gt;tool: discord-notify.yml\&quot;]:::notify\nN_STATUS --&gt; DISCORD[/\&quot;Discord Webhook\&quot;/]:::external\n\n%% ---------- MANUAL RELEASE GATE ----------\nGATE{{\&quot;Manual approval gate&lt;br/&gt;workflow_dispatch(release_tag)\&quot;}}:::gate\nT_MANUAL --&gt; GATE\nART_HUB_RELEASE -.-&gt;|\&quot;image for tag must exist\&quot;| GATE\n\n%% ---------- STAGE 5: production deploy ----------\nJ_DEPLOY[\&quot;job: deploy&lt;br/&gt;tool: appleboy/ssh-action → just deploy-prod&lt;br/&gt;env: production\&quot;]:::job\nART_BACKUP[(\&quot;prod server disk:&lt;br/&gt;./backups/prod_backup_&amp;lt;timestamp&amp;gt;.sql\&quot;)]:::artifact\nGATE --&gt; J_DEPLOY\nART_HUB_RELEASE -.-&gt;|\&quot;compose pulls image\&quot;| J_DEPLOY\nJ_DEPLOY --&gt; ART_BACKUP\nJ_DEPLOY --&gt; N_DEPLOY\n\nN_DEPLOY[\&quot;job: notify-deploy&lt;br/&gt;tool: discord-notify.yml\&quot;]:::notify\nN_DEPLOY --&gt; DISCORD\n\n%% ---------- STAGE 6: production health check ----------\nJ_PHCHECK[\&quot;job: prod-health-check&lt;br/&gt;tool: curl retry loop&lt;br/&gt;env: production\&quot;]:::job\nART_LASTGOOD[(\&quot;prod server disk:&lt;br/&gt;.last_good_tag\&quot;)]:::artifact\nJ_DEPLOY --&gt;|\&quot;needs: deploy (success)\&quot;| J_PHCHECK\nJ_PHCHECK --&gt;|\&quot;on success\&quot;| ART_LASTGOOD\nJ_PHCHECK --&gt; N_PHCHECK\n\nN_PHCHECK[\&quot;job: notify-prod-health-check&lt;br/&gt;tool: discord-notify.yml\&quot;]:::notify\nN_PHCHECK --&gt; DISCORD\n\n%% ---------- STAGE 7: automatic rollback (failure path) ----------\nJ_ROLLBACK[\&quot;job: rollback-prod&lt;br/&gt;tool: appleboy/ssh-action → just rollback-prod&lt;br/&gt;env: production\&quot;]:::job\nJ_PHCHECK -.-&gt;|\&quot;failure()\&quot;| J_ROLLBACK\nART_LASTGOOD -.-&gt;|\&quot;read rollback target\&quot;| J_ROLLBACK\nJ_ROLLBACK --&gt; N_ROLLBACK\n\nN_ROLLBACK[\&quot;job: notify-rollback&lt;br/&gt;tool: discord-notify.yml\&quot;]:::notify\nN_ROLLBACK --&gt; DISCORD&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_eAVCZn8PrXLEvey9vfh-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
