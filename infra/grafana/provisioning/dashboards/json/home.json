        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 14,
      "title": "Running backend release",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "umtas_build_info",
          "refId": "A",
