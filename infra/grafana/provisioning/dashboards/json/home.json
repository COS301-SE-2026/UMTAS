      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 12,
      "title": "Observed availability (30d; collected samples only)",
      "type": "stat",
      "gridPos": {
        "x": 12,
